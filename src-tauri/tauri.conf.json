{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TouchKeyboard",
  "version": "0.1.0",
  "identifier": "com.touchkb.keyboard",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "keyboard",
        "title": "触屏键盘",
        "url": "index.html",
        "width": 900,
        "height": 320,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false,
        "focus": false,
        "visible": false
      },
      {
        "label": "ball",
        "title": "悬浮球",
        "url": "ball.html",
        "width": 56,
        "height": 56,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false,
        "focus": false,
        "visible": false
      },
      {
        "label": "settings",
        "title": "键盘设置",
        "url": "settings.html",
        "width": 400,
        "height": 700,
        "transparent": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false,
        "focus": false,
        "visible": false
      },
      {
        "label": "touchpad",
        "title": "触摸板",
        "url": "touchpad.html",
        "width": 440,
        "height": 400,
        "transparent": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false,
        "focus": false,
        "visible": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ]
  }
}
